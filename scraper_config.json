{
  "api_base": "https://atsu.moe/",
  "cdn_prefix": "https://cdn.atsu.moe/",
  "endpoints": {
    "manga_page": "api/manga/page",
    "all_chapters": "api/manga/allChapters",
    "read_chapter": "api/read/chapter",
    "search": "collections/manga/documents/search",
    "filters": "api/explore/availableFilters",
    "popular": "api/home2/popular",
    "recent": "api/home2/recentlyUpdated",
    "hot": "api/home2/hotUpdates",
    "top_rated": "api/home2/topRated",
    "rising": "api/home2/rising",
    "hidden_gems": "api/home2/hiddenGems"
  },
  "query_params": {
    "manga_page_id": "id",
    "chapters_manga_id": "mangaId",
    "read_manga_id": "mangaId",
    "read_chapter_id": "chapterId"
