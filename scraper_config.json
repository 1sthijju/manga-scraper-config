  "fields": {
    "cover_path": ["largeImage", "poster.largeImage", "image"],
    "scanlator_name": ["scanlatorName", "scanlationManga.name", "scanlator.name"],
    "page_image": "image",
    "manga_page_wrapper": "mangaPage"
  },
  "cdn_mirrors": [
    "https://mirror1.atsu.moe/",
    "https://mirror2.atsu.moe/"
  ],
  "min_app_version": 1
